struct GitFileChange {
    path: text::Text,
    change_type: text::Text,
    additions: i64,
    deletions: i64,
}

impl GitFileChange: Clone {}

struct GitStatusInfo {
    is_repo: bool,
    branch: text::Text,
    staged: vec::Vec[GitFileChange],
    unstaged: vec::Vec[GitFileChange],
}

impl GitStatusInfo {
    fn empty() -> GitStatusInfo {
        return GitStatusInfo {
            is_repo: false,
            branch: text::from_str(""),
            staged: vec::new::[GitFileChange](),
            unstaged: vec::new::[GitFileChange](),
        };
    }

    fn format_summary(this) -> text::Text {
        if !this.is_repo { return text::from_str(""); }
        var out: text::Text = text::new();
        if !this.branch.is_empty() {
            let _ = out.append("Branch: ${this.branch.view()}\n");
        }
        if this.staged.count() > (0 as usize) {
            let _ = out.append("Staged:\n");
            var i: usize = 0 as usize;
            while i < this.staged.count() {
                if let option::Option::Some(fp) = this.staged.at_ptr(i) {
                    let _ = out.append("  ${(*fp).change_type.view()} ${(*fp).path.view()} (+${(*fp).additions}/-${(*fp).deletions})\n");
                }
                i = i +% (1 as usize);
            }
        }
        if this.unstaged.count() > (0 as usize) {
            let _ = out.append("Unstaged:\n");
            var i: usize = 0 as usize;
            while i < this.unstaged.count() {
                if let option::Option::Some(fp) = this.unstaged.at_ptr(i) {
                    let _ = out.append("  ${(*fp).change_type.view()} ${(*fp).path.view()} (+${(*fp).additions}/-${(*fp).deletions})\n");
                }
                i = i +% (1 as usize);
            }
        }
        return out;
    }
}

