struct AccountInfo {
    email: text::Text,
    first_name: text::Text,
    last_name: text::Text,
    team_name: text::Text,
    principal_type: text::Text,
    method_id: text::Text,
}

impl AccountInfo: Clone {}

impl AccountInfo {
    fn empty() -> AccountInfo {
        return AccountInfo {
            email: text::from_str(""),
            first_name: text::from_str(""),
            last_name: text::from_str(""),
            team_name: text::from_str(""),
            principal_type: text::from_str(""),
            method_id: text::from_str(""),
        };
    }

    fn display_name(this) -> text::Text {
        if !this.first_name.is_empty() && !this.last_name.is_empty() {
            return "${this.first_name.view()} ${this.last_name.view()}";
        }
        if !this.first_name.is_empty() {
            return this.first_name.clone();
        }
        return this.email.clone();
    }
}

