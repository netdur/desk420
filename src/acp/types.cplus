// src/acp/types.cplus — typed ACP protocol messages, encoders, and defensive decoders.
//
// Decoders follow the Grok 1.0.92 ACP protocol over stdio and degrade gracefully
// on unknown update kinds, tool kinds, or missing fields.

import "json/json" as json;
import "stdlib/option" as option;
import "stdlib/result" as result;
import "stdlib/text" as text;
import "stdlib/vec" as vec;

import "./wire" as wire;

// ───────────────────────────── enums ─────────────────────────────

enum StopReason {
    EndTurn,
    Cancelled,
    MaxTokens,
    Refusal,
    Unknown(text::Text),
}

impl StopReason {
    #[keeps(nothing)]
    fn from_str(s: str) -> StopReason {
        if s == "end_turn" { return StopReason::EndTurn; }
        if s == "cancelled" { return StopReason::Cancelled; }
        if s == "max_tokens" { return StopReason::MaxTokens; }
        if s == "refusal" { return StopReason::Refusal; }
        return StopReason::Unknown(text::from_str(s));
    }

    fn clone(this) -> StopReason {
        return match this {
            StopReason::EndTurn => StopReason::EndTurn,
            StopReason::Cancelled => StopReason::Cancelled,
            StopReason::MaxTokens => StopReason::MaxTokens,
            StopReason::Refusal => StopReason::Refusal,
            StopReason::Unknown(t) => StopReason::Unknown(t.clone()),
        };
    }

    fn is_end_turn(this) -> bool {
        return match this {
            StopReason::EndTurn => true,
            _ => false,
        };
    }

    fn is_cancelled(this) -> bool {
        return match this {
            StopReason::Cancelled => true,
            _ => false,
        };
    }
}

enum ToolStatus {
    Pending,
    InProgress,
    Completed,
    Failed,
    Unknown(text::Text),
}

impl ToolStatus {
    #[keeps(nothing)]
    fn from_str(s: str) -> ToolStatus {
        if s == "pending" { return ToolStatus::Pending; }
        if s == "in_progress" { return ToolStatus::InProgress; }
        if s == "completed" { return ToolStatus::Completed; }
        if s == "failed" { return ToolStatus::Failed; }
        return ToolStatus::Unknown(text::from_str(s));
    }

    fn clone(this) -> ToolStatus {
        return match this {
            ToolStatus::Pending => ToolStatus::Pending,
            ToolStatus::InProgress => ToolStatus::InProgress,
            ToolStatus::Completed => ToolStatus::Completed,
            ToolStatus::Failed => ToolStatus::Failed,
            ToolStatus::Unknown(t) => ToolStatus::Unknown(t.clone()),
        };
    }

    fn is_completed(this) -> bool {
        return match this {
            ToolStatus::Completed => true,
            _ => false,
        };
    }

    fn is_failed(this) -> bool {
        return match this {
            ToolStatus::Failed => true,
            _ => false,
        };
    }
}

enum ToolKind {
    Read,
    Edit,
    Execute,
    Search,
    Other,
    Unknown(text::Text),
}

impl ToolKind {
    #[keeps(nothing)]
    fn from_str(s: str) -> ToolKind {
        if s == "read" { return ToolKind::Read; }
        if s == "edit" { return ToolKind::Edit; }
        if s == "execute" { return ToolKind::Execute; }
        if s == "search" { return ToolKind::Search; }
        if s == "other" { return ToolKind::Other; }
        return ToolKind::Unknown(text::from_str(s));
    }

    fn clone(this) -> ToolKind {
        return match this {
            ToolKind::Read => ToolKind::Read,
            ToolKind::Edit => ToolKind::Edit,
            ToolKind::Execute => ToolKind::Execute,
            ToolKind::Search => ToolKind::Search,
            ToolKind::Other => ToolKind::Other,
            ToolKind::Unknown(t) => ToolKind::Unknown(t.clone()),
        };
    }
}

enum PermissionKind {
    AllowOnce,
    AllowAlways,
    RejectOnce,
    RejectAlways,
    Unknown(text::Text),
}

impl PermissionKind {
    #[keeps(nothing)]
    fn from_str(s: str) -> PermissionKind {
        if s == "allow_once" { return PermissionKind::AllowOnce; }
        if s == "allow_always" { return PermissionKind::AllowAlways; }
        if s == "reject_once" { return PermissionKind::RejectOnce; }
        if s == "reject_always" { return PermissionKind::RejectAlways; }
        return PermissionKind::Unknown(text::from_str(s));
    }

    fn clone(this) -> PermissionKind {
        return match this {
            PermissionKind::AllowOnce => PermissionKind::AllowOnce,
            PermissionKind::AllowAlways => PermissionKind::AllowAlways,
            PermissionKind::RejectOnce => PermissionKind::RejectOnce,
            PermissionKind::RejectAlways => PermissionKind::RejectAlways,
            PermissionKind::Unknown(t) => PermissionKind::Unknown(t.clone()),
        };
    }
}

// ───────────────────────────── structs ─────────────────────────────

struct ConfigChoice {
    value: text::Text,
    name: text::Text,
}

impl ConfigChoice: Clone {}

struct ConfigOption {
    id: text::Text,
    name: text::Text,
    category: text::Text,
    current_value: text::Text,
    choices: vec::Vec[ConfigChoice],
}

impl ConfigOption {
    fn clone(this) -> ConfigOption {
        var out: vec::Vec[ConfigChoice] = vec::new::[ConfigChoice]();
        var i: usize = 0 as usize;
        while i < this.choices.count() {
            if let option::Option::Some(p) = this.choices.at_ptr(i) {
                let _ = out.append((*p).clone());
            }
            i = i +% (1 as usize);
        }
        return ConfigOption {
            id: this.id.clone(),
            name: this.name.clone(),
            category: this.category.clone(),
            current_value: this.current_value.clone(),
            choices: out,
        };
    }
}

