enum PlanStatus {
    Pending,
    InProgress,
    Completed,
}

impl PlanStatus {
    fn from_str(s: str) -> PlanStatus {
        if s == "completed" || s == "done" { return PlanStatus::Completed; }
        if s == "in_progress" || s == "in-progress" || s == "running" { return PlanStatus::InProgress; }
        return PlanStatus::Pending;
    }

}

struct PlanEntry {
    content: text::Text,
    priority: text::Text,
    status: PlanStatus,
}

impl PlanEntry {
    fn clone(this) -> PlanEntry {
        return PlanEntry {
            content: this.content.clone(),
            priority: this.priority.clone(),
            status: this.status,
        };
    }
}

