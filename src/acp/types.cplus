fn params_empty() -> json::Value {
    return json::Value::object(vec::new::[json::Member]());
}

fn params_session_prompt(session_id: str, prompt_text: str, attachments: vec::Vec[Attachment]) -> json::Value {
    var arr: vec::Vec[json::Value] = vec::new::[json::Value]();

    var blk: vec::Vec[json::Member] = vec::new::[json::Member]();
    let _ = blk.append(json::Member::new("type", json::Value::text("text")));
    let _ = blk.append(json::Member::new("text", json::Value::text(prompt_text)));
    let _ = arr.append(json::Value::object(blk));

    var i: usize = 0 as usize;
    while i < attachments.count() {
        if let option::Option::Some(ap) = attachments.at_ptr(i) {
            if (*ap).is_image {
                var ib: vec::Vec[json::Member] = vec::new::[json::Member]();
                let _ = ib.append(json::Member::new("type", json::Value::text("image")));
                let _ = ib.append(json::Member::new("mimeType", json::Value::text((*ap).mime_type.view())));
                let _ = ib.append(json::Member::new("data", json::Value::text((*ap).data_or_text.view())));
                let _ = arr.append(json::Value::object(ib));
            } else {
                var res_m: vec::Vec[json::Member] = vec::new::[json::Member]();
                let uri: text::Text = "file://${(*ap).path.view()}";
                let _ = res_m.append(json::Member::new("uri", json::Value::text(uri.view())));
                let _ = res_m.append(json::Member::new("mimeType", json::Value::text((*ap).mime_type.view())));
                let _ = res_m.append(json::Member::new("text", json::Value::text((*ap).data_or_text.view())));
                var rb: vec::Vec[json::Member] = vec::new::[json::Member]();
                let _ = rb.append(json::Member::new("type", json::Value::text("resource")));
                let _ = rb.append(json::Member::new("resource", json::Value::object(res_m)));
                let _ = arr.append(json::Value::object(rb));
            }
        }
        i = i +% (1 as usize);
    }

    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    let _ = m.append(json::Member::new("sessionId", json::Value::text(session_id)));
    let _ = m.append(json::Member::new("prompt", json::Value::array(arr)));
    return json::Value::object(m);
}

