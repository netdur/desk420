// ───────────────────────────── JSON helpers ─────────────────────────────

fn _opt_str_field(obj: json::Value, key: str) -> option::Option[text::Text] {
    return match obj.value(for_key: key) {
        option::Option::Some(v) => v.as_text(),
        option::Option::None => option::Option[text::Text]::None,
    };
}

// ───────────────────────────── outgoing param builders ─────────────────────────────

fn params_initialize() -> json::Value {
    var fs_m: vec::Vec[json::Member] = vec::new::[json::Member]();
    let _ = fs_m.append(json::Member::new("readTextFile", json::Value::boolean(false)));
    let _ = fs_m.append(json::Member::new("writeTextFile", json::Value::boolean(false)));

    var cap_m: vec::Vec[json::Member] = vec::new::[json::Member]();
    let _ = cap_m.append(json::Member::new("fs", json::Value::object(fs_m)));
    let _ = cap_m.append(json::Member::new("terminal", json::Value::boolean(false)));

    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    let _ = m.append(json::Member::new("protocolVersion", json::Value::number(1.0)));
    let _ = m.append(json::Member::new("clientCapabilities", json::Value::object(cap_m)));
    return json::Value::object(m);
}

fn params_session_new_with_mcp(cwd: str, take mcp_servers: vec::Vec[json::Value]) -> json::Value {
    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    let _ = m.append(json::Member::new("cwd", json::Value::text(cwd)));
    let _ = m.append(json::Member::new("mcpServers", json::Value::array(mcp_servers)));
    return json::Value::object(m);
}

fn params_session_new(cwd: str) -> json::Value {
    return params_session_new_with_mcp(cwd, vec::new::[json::Value]());
}

fn params_session_load_with_mcp(session_id: str, cwd: str, take mcp_servers: vec::Vec[json::Value]) -> json::Value {
    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    let _ = m.append(json::Member::new("sessionId", json::Value::text(session_id)));
    let _ = m.append(json::Member::new("cwd", json::Value::text(cwd)));
    let _ = m.append(json::Member::new("mcpServers", json::Value::array(mcp_servers)));
    return json::Value::object(m);
}

fn params_session_prompt_text(session_id: str, prompt_text: str) -> json::Value {
    var blk: vec::Vec[json::Member] = vec::new::[json::Member]();
    let _ = blk.append(json::Member::new("type", json::Value::text("text")));
    let _ = blk.append(json::Member::new("text", json::Value::text(prompt_text)));

    var arr: vec::Vec[json::Value] = vec::new::[json::Value]();
    let _ = arr.append(json::Value::object(blk));

    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    let _ = m.append(json::Member::new("sessionId", json::Value::text(session_id)));
    let _ = m.append(json::Member::new("prompt", json::Value::array(arr)));
    return json::Value::object(m);
}

