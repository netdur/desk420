    _ensure_global();
    _STORE.begin_load(session_id, cwd: cwd, title: title, clear_blocks: clear_blocks);
}

fn mark_loaded(session_id: str) { _ensure_global(); _STORE.mark_loaded(session_id); }
fn mark_load_failed(session_id: str, message: str) { _ensure_global(); _STORE.mark_load_failed(session_id, message); }
fn reset_session_blocks(session_id: str, cwd: str = "", title: str = "") {
    _ensure_global();
    _STORE.reset_session_blocks(session_id, cwd: cwd, title: title);
}
fn mark_read(session_id: str) { _ensure_global(); _STORE.mark_read(session_id); }
fn mark_unread(session_id: str) { _ensure_global(); _STORE.mark_unread(session_id); }
fn set_config_options(session_id: str, take opts: vec::Vec[types::ConfigOption]) {
    _ensure_global();
    _STORE.set_config_options(session_id, opts);
}
fn set_config_value_optimistic(session_id: str, config_id: str, value: str) {
    _ensure_global();
    _STORE.set_config_value_optimistic(session_id, config_id, value);
}
fn begin_turn(session_id: str, user_text: str) { _ensure_global(); _STORE.begin_turn(session_id, user_text); }
fn apply_prompt_result(session_id: str, res: types::PromptResult) { _ensure_global(); _STORE.apply_prompt_result(session_id, res); }
fn apply_turn_error(session_id: str, message: str) { _ensure_global(); _STORE.apply_turn_error(session_id, message); }
fn apply_permission_request(req: types::PermissionRequest) { _ensure_global(); _STORE.apply_permission_request(req); }
