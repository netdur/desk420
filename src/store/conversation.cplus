fn pending_permission(session_id: str) -> option::Option[PermissionBlock] {
    _ensure_global();
    guard let option::Option::Some(sidx) = _STORE.find_session_index(session_id) else {
        return option::Option[PermissionBlock]::None;
    };
    guard let option::Option::Some(sp) = _STORE.sessions.at_ptr(sidx) else {
        return option::Option[PermissionBlock]::None;
    };
    var i: usize = (*sp).blocks.count();
    while i > (0 as usize) {
        i = i -% (1 as usize);
        if let option::Option::Some(bp) = (*sp).blocks.at_ptr(i) {
            if let option::Option::Some(pb) = (*bp).clone_permission_block() {
                let open: bool = match pb.resolved_option {
                    option::Option::None => true,
                    _ => false,
                };
                if open { return option::Option[PermissionBlock]::Some(pb); }
            }
        }
    }
    return option::Option[PermissionBlock]::None;
}

fn last_answer_text(session_id: str) -> text::Text {
    _ensure_global();
    guard let option::Option::Some(sidx) = _STORE.find_session_index(session_id) else {
        return text::from_str("");
    };
    guard let option::Option::Some(sp) = _STORE.sessions.at_ptr(sidx) else {
        return text::from_str("");
    };
    let n: usize = (*sp).blocks.count();
    if n == (0 as usize) { return text::from_str(""); }
    var chunks: vec::Vec[text::Text] = vec::new::[text::Text]();
    var i: usize = n;
    while i > (0 as usize) {
        i = i -% (1 as usize);
        if let option::Option::Some(bp) = (*sp).blocks.at_ptr(i) {
            let k: BlockKind = (*bp).kind();
            if k == BlockKind::AgentText {
                let body: text::Text = (*bp).text_body();
                if !body.is_empty() {
                    let _ = chunks.append(body);
                }
            } else if k == BlockKind::UserText && chunks.count() > (0 as usize) {
                break;
            }
        }
    }
    var out: text::Text = text::new();
    var ci: usize = chunks.count();
    while ci > (0 as usize) {
        ci = ci -% (1 as usize);
        if let option::Option::Some(cp) = chunks.at_ptr(ci) {
            if !out.is_empty() { let _ = out.append("\n\n"); }
            let _ = out.append((*cp).view());
        }
    }
    return out;
}

fn export_markdown(session_id: str) -> text::Text {
    _ensure_global();
    guard let option::Option::Some(sidx) = _STORE.find_session_index(session_id) else {
        return text::from_str("");
    };
    guard let option::Option::Some(sp) = _STORE.sessions.at_ptr(sidx) else {
        return text::from_str("");
    };
    var out: text::Text = text::new();
    let title: str = if (*sp).title.is_empty() { "Desk420 Conversation" } else { (*sp).title.view() };
    let _ = out.append("# ${title}\n");
    if !(*sp).cwd.is_empty() && !(*sp).cwd.contains(".desk420/") {
        let _ = out.append("\n_Project: `${(*sp).cwd.view()}`_\n");
    }
    var i: usize = 0 as usize;
    while i < (*sp).blocks.count() {
        if let option::Option::Some(bp) = (*sp).blocks.at_ptr(i) {
            let k: BlockKind = (*bp).kind();
            if k == BlockKind::UserText {
                let body: text::Text = (*bp).text_body();
                if !body.is_empty() {
                    let _ = out.append("\n## You\n\n${body.view()}\n");
                }
            } else if k == BlockKind::AgentText {
                let body: text::Text = (*bp).text_body();
                if !body.is_empty() {
                    let _ = out.append("\n## Grok\n\n${body.view()}\n");
                }
            } else if k == BlockKind::ToolCall {
                if let option::Option::Some(tb) = (*bp).clone_tool_block() {
                    let tlabel: str = if tb.title.is_empty() { "Tool" } else { tb.title.view() };
                    let _ = out.append("\n> **${tlabel}**\n");
                    if !tb.output_text.is_empty() {
                        let _ = out.append("\n```text\n${tb.output_text.view()}\n```\n");
                    }
                }
            }
        }
        i = i +% (1 as usize);
    }
    return out;
}

// ───────────────────────────── tests ─────────────────────────────

fn _replay_fixture_into_store(ref store: ConversationStore, fixture_path: str) -> usize {
    guard let result::Result::Ok(contents) = fs::read_to_string(fixture_path) else {
        assert false;
        return 0 as usize;
    };
    let lines: vec::Vec[str] = contents.view().split(separator: "\n");
    var decoded: usize = 0 as usize;
    var i: usize = 0 as usize;
    while i < lines.count() {
        if let option::Option::Some(line) = lines.at(i) {
            let trimmed: str = line.trim();
            if !trimmed.is_empty() {
                if let result::Result::Ok(rec) = json::Value::parse(source: trimmed) {
                    if let option::Option::Some(dir_v) = rec.value(for_key: "dir") {
                        if let option::Option::Some(dir_t) = dir_v.as_text() {
                            if dir_t.equals("<") {
                                if let option::Option::Some(msg_v) = rec.value(for_key: "msg") {
                                    let msg_line: text::Text = msg_v.to_text();
                                    match wire::decode_line(msg_line.view()) {
                                        wire::Envelope::Notification(n) => {
                                            if n.method.equals("session/update") {
                                                if let option::Option::Some(env) = types::decode_session_update(n.params) {
                                                    store.apply_update(env);
                                                    decoded = decoded +% (1 as usize);
                                                }
                                            }
                                        }
                                        wire::Envelope::Request(r) => {
                                            if r.method.equals("session/request_permission") {
                                                if let option::Option::Some(pr) = types::decode_permission_request(r.id, r.params) {
                                                    store.apply_permission_request(pr);
                                                    decoded = decoded +% (1 as usize);
                                                }
                                            }
                                        }
                                        wire::Envelope::Response(_resp) => {}
                                        wire::Envelope::Invalid(_e) => { assert false; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i +% (1 as usize);
    }
    return decoded;
}

fn _block_has_completed_diff(b: Block, expected_new: str) -> bool {
    return match b {
        Block::ToolCall(tb) => !tb.diff_path.is_empty() && tb.diff_new.equals(expected_new) && tb.status.is_completed(),
        _ => false,
    };
}

fn _block_has_completed_bash_containing(b: Block, needle: str) -> bool {
    return match b {
        Block::ToolCall(tb) => tb.family.equals("Bash") && tb.output_text.contains(needle) && tb.status.is_completed(),
        _ => false,
    };
}

fn _block_is_rejected_tool(b: Block) -> bool {
    return match b {
        Block::ToolCall(tb) => tb.status.is_failed() && tb.tool_not_run.equals("rejected"),
        _ => false,
    };
}

fn _block_is_completed_tool(b: Block) -> bool {
    return match b {
        Block::ToolCall(tb) => tb.status.is_completed(),
        _ => false,
    };
}

fn _session_permission_count(s: SessionState) -> usize {
    var c: usize = 0 as usize;
    var i: usize = 0 as usize;
    while i < s.blocks.count() {
        if let option::Option::Some(bp) = s.blocks.at_ptr(i) {
            if (*bp).is_permission() { c = c +% (1 as usize); }
        }
        i = i +% (1 as usize);
    }
    return c;
}

#[test]
fn fixture_main_decodes_tools_diffs_and_messages() {
    var store: ConversationStore = ConversationStore::new();
    let n: usize = _replay_fixture_into_store(store, "fixtures/acp/grok-1.0.92-main.jsonl");
    assert n > (50 as usize);
    assert store.session_count() == (2 as usize);

    guard let option::Option::Some(sp) = store.session_ptr(0 as usize) else { assert false; return; };
    assert !(*sp).title.is_empty();
    assert (*sp).tool_call_count() >= (2 as usize);
    assert (*sp).config_options.count() >= (2 as usize);
    assert !(*sp).all_agent_text().is_empty();

    var saw_diff: bool = false;
    var saw_bash_ok: bool = false;
    var bi: usize = 0 as usize;
    while bi < (*sp).blocks.count() {
        if let option::Option::Some(bp) = (*sp).blocks.at_ptr(bi) {
            if _block_has_completed_diff(*bp, "hi") { saw_diff = true; }
            if _block_has_completed_bash_containing(*bp, "spike-ok") { saw_bash_ok = true; }
        }
        bi = bi +% (1 as usize);
    }
    assert saw_diff;
    assert saw_bash_ok;
}

#[test]
fn fixture_permission_decodes_permission_requests_and_rejection() {
    var store: ConversationStore = ConversationStore::new();
    let n: usize = _replay_fixture_into_store(store, "fixtures/acp/grok-1.0.92-permission.jsonl");
    assert n > (20 as usize);
    assert store.session_count() == (1 as usize);

    guard let option::Option::Some(sp) = store.session_ptr(0 as usize) else { assert false; return; };
    assert _session_permission_count(*sp) == (2 as usize);
    assert (*sp).turn_state.is_waiting_permission();

    var saw_rejected: bool = false;
    var bi: usize = 0 as usize;
    while bi < (*sp).blocks.count() {
        if let option::Option::Some(bp) = (*sp).blocks.at_ptr(bi) {
            if _block_is_rejected_tool(*bp) { saw_rejected = true; }
        }
        bi = bi +% (1 as usize);
    }
    assert saw_rejected;
}

#[test]
fn fixture_session_load_decodes_replayed_history_and_finished_tools() {
    var store: ConversationStore = ConversationStore::new();
    let n: usize = _replay_fixture_into_store(store, "fixtures/acp/grok-1.0.92-session-load.jsonl");
    assert n > (15 as usize);
    assert store.session_count() == (1 as usize);

    guard let option::Option::Some(sp) = store.session_ptr(0 as usize) else { assert false; return; };
    assert (*sp).all_user_text().contains("hello.txt");
    assert (*sp).tool_call_count() == (5 as usize);

    var completed: usize = 0 as usize;
    var bi: usize = 0 as usize;
    while bi < (*sp).blocks.count() {
        if let option::Option::Some(bp) = (*sp).blocks.at_ptr(bi) {
            if _block_is_completed_tool(*bp) { completed = completed +% (1 as usize); }
        }
        bi = bi +% (1 as usize);
    }
    assert completed == (5 as usize);
}

#[test]
fn fixture_mcp_tool_turn_decodes_cleanly() {
    var store: ConversationStore = ConversationStore::new();
    let n: usize = _replay_fixture_into_store(store, "fixtures/acp/grok-1.0.92-mcp-tool-turn.jsonl");
    assert n > (20 as usize);
    assert store.session_count() == (1 as usize);
    guard let option::Option::Some(sp) = store.session_ptr(0 as usize) else { assert false; return; };
    assert !(*sp).all_agent_text().is_empty();
    assert (*sp).tool_call_count() == (2 as usize);
}

static _BATCH_TEST_MASK: u64 = 0 as u64;
static _BATCH_TEST_COUNT: usize = 0 as usize;

fn _on_batch_test_change(ch: StoreChange, _ctx: *u8) {
    _BATCH_TEST_COUNT = _BATCH_TEST_COUNT +% (1 as usize);
    if ch.session_index == (0 as usize) {
        _BATCH_TEST_MASK = _BATCH_TEST_MASK | (1 as u64);
    } else if ch.session_index == (1 as usize) {
        _BATCH_TEST_MASK = _BATCH_TEST_MASK | (2 as u64);
    }
}

#[test]
fn batch_emits_notification_for_every_modified_session() {
    _BATCH_TEST_MASK = 0 as u64;
    _BATCH_TEST_COUNT = 0 as usize;
    var store: ConversationStore = ConversationStore::new();
    let _sub: events::SignalSubscription[StoreChange] = store._changes.on(_on_batch_test_change);

    store.begin_batch();
    store.begin_turn("s-alpha", "first");
    store.begin_turn("s-beta", "second");
    store.apply_turn_error("s-alpha", "err");
    store.end_batch();

    // Both session 0 and session 1 must be notified, with duplicates coalesced.
    assert _BATCH_TEST_COUNT == (2 as usize);
    assert _BATCH_TEST_MASK == (3 as u64);
}

#[test]
fn export_markdown_formats_turns_and_title() {
    begin_turn("exp-1", "Show hello");
    set_session_title("exp-1", "Hello Session");
    apply_update(types::SessionUpdateEnvelope {
        session_id: text::from_str("exp-1"),
        update: types::SessionUpdate::AgentMessageChunk(text::from_str("Hello from Grok!")),
    });
    let md_out: text::Text = export_markdown("exp-1");
    assert md_out.contains("# Hello Session");
    assert md_out.contains("## You");
    assert md_out.contains("Show hello");
    assert md_out.contains("## Grok");
    assert md_out.contains("Hello from Grok!");
}
